<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Blogify</title>
</head>

<body class="bg-surface min-h-screen">

    <%- include('partials/nav') %>

    <section class="relative h-[500px] overflow-hidden">

        <img src="/images/hero.jpg"
             alt="Blog Writing"
             class="absolute inset-0 w-full h-full object-cover">

        <div class="absolute inset-0 bg-black/50"></div>

        <div class="relative z-10 h-full flex items-center">
            <div class="max-w-7xl mx-auto px-6">

                <div class="max-w-3xl text-white">

                    <h1 class="text-5xl md:text-6xl font-extrabold leading-tight mb-6">
                        Share Your Stories,<br>
                        Inspire The World
                    </h1>

                    <p class="text-xl text-gray-200 mb-8">
                        Discover ideas, experiences and insights from writers across the globe.
                    </p>

                    <% if(!locals.user){ %>
                        <a href="/user/signup"
                           class="bg-[#248E41] hover:bg-[#00591D] text-white px-8 py-4 rounded-xl font-semibold transition">
                            Start Writing
                        </a>
                    <% } else { %>
                        <a href="/blog/add-new"
                           class="bg-[#248E41] hover:bg-[#00591D] text-white px-8 py-4 rounded-xl font-semibold transition">
                            Write Your Story
                        </a>
                    <% } %>

                </div>

            </div>
        </div>

    </section>

    <div class="max-w-5xl mx-auto px-6 -mt-16 relative z-20 mb-16">

        <div class="bg-white rounded-3xl shadow-card p-8 flex justify-center gap-20">

            <div class="text-center">
                <h3 class="text-4xl font-bold text-[#248E41]"><%= blogs.length %></h3>
                <p class="text-gray-500">Published Articles</p>
            </div>

            <div class="text-center">
                <h3 class="text-4xl font-bold text-[#248E41]">Blogify</h3>
                <p class="text-gray-500">Writing Community</p>
            </div>

        </div>

    </div>

    <div class="max-w-7xl mx-auto px-6 pb-16">

        <div class="mb-8">
            <h2 class="text-4xl font-bold text-[#00591D]">Latest Articles</h2>
            <p class="text-gray-600 mt-2">Explore stories from our community.</p>
        </div>

        <% if(blogs.length === 0){ %>

            <div class="bg-white rounded-3xl p-16 text-center shadow-card">
                <h2 class="text-3xl font-bold text-gray-700 mb-3">No Blogs Found</h2>
                <p class="text-gray-500">Try another search keyword.</p>
            </div>

        <% } else { %>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

            <% blogs.forEach(blog => { %>

            <article class="bg-white rounded-3xl overflow-hidden shadow-card hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col">

                <img src="/<%= blog.coverImageURL %>"
                     alt="<%= blog.title %>"
                     class="w-full h-56 object-cover transition-transform duration-500 hover:scale-105">

                <div class="p-6 flex flex-col flex-grow">

                    <h2 class="text-xl font-bold text-gray-800 mb-3">
                        <%= blog.title %>
                    </h2>

                    <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
                        <img src="/<%= blog.created_by.profileImageURL %>"
                             class="w-8 h-8 rounded-full">

                        <span><%= blog.created_by.fullName %></span>
                        <span>•</span>
                        <span><%= blog.createdAt.toDateString() %></span>
                    </div>

                    <p class="text-gray-600 h-20 overflow-hidden mb-5">
                        <%= blog.body.substring(0,120) %>...
                    </p>

                    <a href="/blog/<%= blog._id %>"
                       class="mt-auto block text-center bg-[#248E41] hover:bg-[#00591D] text-white py-3 rounded-xl font-medium transition">
                        Read Article
                    </a>

                </div>

            </article>

            <% }) %>

        </div>

        <% } %>

    </div>

    <footer class="bg-[#00591D] text-white mt-20">
        <div class="max-w-7xl mx-auto px-6 py-8 text-center">
            <h3 class="text-2xl font-bold">Blogify</h3>
            <p class="text-green-100 mt-2">Share stories. Inspire people.</p>
        </div>
    </footer>

    <%- include('partials/script') %>

</body>
</html>
