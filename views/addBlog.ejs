<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Create Article | Blogify</title>
</head>

<body class="bg-surface min-h-screen">

    <%- include('partials/nav') %>

    <main class="max-w-4xl mx-auto px-6 py-10">

        <div
            class="
            bg-white
            rounded-3xl
            shadow-card
            overflow-hidden
            "
        >

            <div
                class="
                bg-gradient-to-r
                from-[#248E41]
                to-[#47AB5A]
                text-white
                p-8
                "
            >

                <h1 class="text-4xl font-extrabold mb-2">
                    Create New Article
                </h1>

                <p class="text-green-100">
                    Share your knowledge, ideas and experiences with the community.
                </p>

            </div>

            <form
                action="/blog/add-new"
                method="POST"
                enctype="multipart/form-data"
                class="p-8"
            >

                <div class="mb-6">

                    <label
                        for="coverImage"
                        class="
                        block
                        text-sm
                        font-semibold
                        text-gray-700
                        mb-2
                        "
                    >
                        Cover Image
                    </label>

                    <input
                        type="file"
                        id="coverImage"
                        name="coverImage"
                        required
                        class="
                        w-full
                        border
                        border-gray-300
                        rounded-xl
                        p-3
                        "
                    >

                </div>

                <div class="mb-6">

                    <label
                        for="title"
                        class="
                        block
                        text-sm
                        font-semibold
                        text-gray-700
                        mb-2
                        "
                    >
                        Blog Title
                    </label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        required
                        placeholder="Enter an engaging title..."
                        class="
                        w-full
                        border
                        border-gray-300
                        rounded-xl
                        p-4
                        focus:outline-none
                        focus:ring-2
                        focus:ring-[#248E41]
                        "
                    >

                </div>

                <div class="mb-8">

                    <label
                        for="body"
                        class="
                        block
                        text-sm
                        font-semibold
                        text-gray-700
                        mb-2
                        "
                    >
                        Content
                    </label>

                    <textarea
                        id="body"
                        name="body"
                        rows="14"
                        required
                        placeholder="Start writing your story..."
                        class="
                        w-full
                        border
                        border-gray-300
                        rounded-xl
                        p-4
                        focus:outline-none
                        focus:ring-2
                        focus:ring-[#248E41]
                        "
                    ></textarea>

                </div>

                <button
                    type="submit"
                    class="
                    bg-[#248E41]
                    hover:bg-[#00591D]
                    text-white
                    px-8
                    py-3
                    rounded-xl
                    font-semibold
                    transition
                    "
                >
                    Publish Article
                </button>

            </form>

        </div>

    </main>

    <%- include('partials/script') %>

</body>
</html>
